{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",                // include scripts at repo root
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "types": ["node", "jest"]
  },
  "include": ["src", "scripts", "db"],
  "exclude": ["node_modules", "db/seed","dist"]  
}
